{
  "agents": [
    {
	  "id":"01",
	  "token":"token_01",
	  "name":"main",
      "defaults": true,
      "workspace": "~/.bot/workspace",
      "model": "dashscope-qwen/qwen3.5-plus",
      "provider": "dashscope",
      "contextMaxTokens": 8192,
      "context_max_history_turns": 5,
      "contextSummaryMaxLength": 150,
      "temperature": 0.1,
      "maxToolIterations": 40,
      "reasoningEffort": null
    },
	{
	  "id":"02",
      "token":"token_02",
	  "name":"search",
      "defaults": true,
      "workspace": "~/.bot/workspace",
      "model": "dashscope-qwen/qwen3.5-plus",
      "provider": "dashscope",
      "contextMaxTokens": 8192,
      "context_max_history_turns": 5,
      "contextSummaryMaxLength": 150,
      "temperature": 0.1,
      "maxToolIterations": 40,
      "reasoningEffort": null
    }
  ],
  "providers": {
    "custom": {
      "apiKey": "",
      "apiBase": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "extraHeaders": null
    },
    "dashscope": {
      "apiKey": "",
      "apiBase": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "extraHeaders": null
    },
    "openai": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "deepseek": {
      "apiKey": "",
