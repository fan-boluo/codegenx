      "extraHeaders": null
    },
    "zhipu": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    },
    "vllm": {
      "apiKey": "",
      "apiBase": null,
      "extraHeaders": null
    }
  },
  "embedding": {
    "apiKey": "",
    "apiBase": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "modelName": "text-embedding-v4"
  },
  "gateway": {
    "host": "0.0.0.0",
    "port": 8765,
    "heartbeat": {
      "enabled": true,
      "intervalS": 1800
    }
  },
  "tools": {
    "websearch": {
      "proxy": null,
      "search": {
