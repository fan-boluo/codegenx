# CodeGenX 单体应用配置示例（原 4 服务的 Nacos/服务地址配置已随单体化移除）

APP_HOST=0.0.0.0
APP_PORT=8456

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=codegenx
MYSQL_USER=user
MYSQL_PASSWORD=your_password
MYSQL_CHARSET=utf8mb4

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=your_password

# qdrant（向量维度不在此配置 —— 见 backend/config.json 的 embedding.dimensions）
QDRANT_URL=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# LLM（DashScope 兼容模式）
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
AI_API_KEY=your_dashscope_api_key
AI_MODEL=qwen-plus

# Hook 扩展监听器模块（逗号分隔的 import 路径，启动时装载；见 docs/Hook设计.md §6）
HOOK_EXTRA_MODULES=

# JWT configuration
# HS256 (default, symmetric) — single shared secret for dev/local
JWT_ALGORITHM=HS256
JWT_SECRET=rainbow
JWT_EXPIRATION_HOURS=24

# RS256 (production, asymmetric) — use with K8s Secret file mounts
# Set JWT_ALGORITHM=RS256 and provide key paths.
# Generate keys: python scripts/generate_jwt_keys.py --output-dir ./keys
# K8s:     kubectl create secret generic jwt-keys --from-file=jwt_private.pem=./keys/jwt_private.pem --from-file=jwt_public.pem=./keys/jwt_public.pem -n codegenx
# JWT_PRIVATE_KEY_PATH=/etc/jwt/jwt_private.pem
# JWT_PUBLIC_KEY_PATH=/etc/jwt/jwt_public.pem
# Fallback (not recommended for production):
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
