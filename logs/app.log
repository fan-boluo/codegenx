20260621 09:47:36 - MainProcess | MainThread | runtime._execute_step:513 - DEBUG -{'content': '', 'tool_calls': [{'id': 'call_4ceb6db2bca348d4b9fcb917', 'name': 'write_file', 'arguments': {'path': 'D:\\Project\\agent\\CodeGenX\\.data\\10\\code\\cnn_classifier.py', 'content': '"""\n新闻标题分类 - CNN 文本分类器 (PyTorch)\n========================================\n功能：\n  1. 训练模式：读取 train.txt 训练 CNN 模型，用 dev.txt 验证，保存最佳模型\n  2. 测试模式：加载已保存模型，在 test.txt 上评估\n  3. 预测模式：加载模型，对单条文本进行分类\n\n数据格式：每行 "标题文本\\t类别编号"（类别 0-9）\n类别映射：0-finance, 1-realty, 2-stocks, 3-education, 4-science,\n          5-society, 6-politics, 7-sports, 8-game, 9-entertainment\n\n用法：\n  训练：  python cnn_classifier.py --mode train\n  测试：  python cnn_classifier.py --mode test\n  预测：  python cnn_classifier.py --mode predict --text "今日股市大涨"\n"""\n\nimport os\nimport re\nimport json\nimport time\nimport argparse\nfrom collections import Counter\n\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import Dataset, DataLoader\n\n# ============================================================\n# 配置参数\n# ============================================================\nclass Config:\n    """模型与训练配置"""\n    # --- 数据路径 ---\n    data_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")\n    train_file = os.path.join(data_dir, "train.txt")\n    dev_file = os.path.join(data_dir, "dev.txt")\n    test_file = os.path.join(data_dir, "test.txt")\n    class_file = os.path.join(data_dir, "class.txt")\n\n    # --- 输出路径 ---\n    output_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "output")\n    model_save_path = os.path.join(output_dir, "cnn_news_model.pt")   # 模型权重+词表\n    result_save_path = os.path.join(output_dir, "test_results.txt")   # 测试结果\n\n    # --- 文本处理 ---\n    max_seq_len = 64        # 标题最大字符数（截断/填充）\n    min_freq = 1            # 词频阈值，低于此值的字符不进入词表\n    vocab_max_size = 8000   # 词表最大大小\n\n    # --- 模型超参 ---\n    embed_dim = 256          # 词嵌入维度\n    num_classes = 10         # 分类类别数\n    kernel_sizes = [2, 3, 4, 5]  # 多种卷积核大小，捕获不同长度的 n-gram 特征\n    num_filters = 256        # 每种卷积核的通道数\n    dropout_rate = 0.3       # Dropout 比率\n\n    # --- 训练超参 ---\n    batch_size = 128\n    learning_rate = 1e-3\n    num_epochs = 20\n    patience = 5             # 早停耐心值（连续多少个 epoch 无提升则停止）\n    device = "cuda" if torch.cuda.is_available() else "cpu"\n\n\n# ============================================================\n# 数据加载与预处理\n# ============================================================\ndef load_data(file_path):\n    """\n    加载数据文件\n    返回: (texts: list[str], labels: list[int])\n    """\n    texts, labels = [], []\n    with open(file_path, "r", encoding="utf-8") as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.rsplit("\\t", 1)\n            if len(parts) != 2:\n                continue\n            text, label = parts[0], int(parts[1])\n            texts.append(text)\n            labels.append(label)\n    return texts, labels\n\n\ndef tokenize_chinese(text):\n    """\n    中文分词：按字符切分，去除空白和标点\n    对于新闻标题这种短文本，字符级效果良好\n    """\n    # 去除空白字符\n    text = re.sub(r"\\s+", "", text)\n    # 去除常见标点符号\n    text = re.sub(\n        r"[^\\u4e00-\\u9fa5a-zA-Z0-9]",\n        "",\n        text,\n    )\n    return list(text)  # 按字符切分\n\n\ndef build_vocab(texts, min_freq=1, max_size=8000):\n    """\n    从训练文本构建字符级词表\n    返回: dict {char: index}\n    特殊 token: <PAD>=0, <UNK>=1\n    """\n    counter = Counter()\n    for text in texts:\n        tokens = tokenize_chinese(text)\n        counter.update(tokens)\n\n    # 按频率排序，取 top max_size\n    vocab = {"<PAD>": 0, "<UNK>": 1}\n    for char, freq in counter.most_common(max_size - 2):\n        if freq >= min_freq:\n            vocab[char] = len(vocab)\n\n    print(f"[词表] 总字符种类: {len(counter)}, 词表大小: {len(vocab)}")\n    return vocab\n\n\ndef encode_text(text, vocab, max_seq_len):\n    """\n    将文本编码为索引序列\n    返回: list[int] 长度为 max_seq_len\n    """\n    tokens = tokenize_chinese(text)\n    ids = [vocab.get(t, vocab["<UNK>"]) for t in tokens]\n    # 截断\n    if len(ids) >= max_seq_len:\n        ids = ids[:max_seq_len]\n    # 填充\n    else:\n        ids = ids + [vocab["<PAD>"]] * (max_seq_len - len(ids))\n    return ids\n\n\n# ============================================================\n# PyTorch Dataset\n# ============================================================\nclass NewsDataset(Dataset):\n    """新闻标题分类数据集"""\n\n    def __init__(self, texts, labels, vocab, max_seq_len):\n        self.texts = texts\n        self.labels = labels\n        self.vocab = vocab\n        self.max_seq_len = max_seq_len\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        ids = encode_text(self.texts[idx], self.vocab, self.max_seq_len)\n        return (\n            torch.tensor(ids, dtype=torch.long),\n            torch.tensor(self.labels[idx], dtype=torch.long),\n        )\n\n\n# ============================================================\n# CNN 模型定义\n# ============================================================\nclass TextCNN(nn.Module):\n    """\n    多通道 TextCNN 文本分类模型\n\n    结构:\n      Embedding → 多组 Conv1d(kernel_size=k) → ReLU → MaxPool → Concat → Dropout → FC\n    """\n\n    def __init__(self, vocab_size, embed_dim, num_classes,\n                 kernel_sizes, num_filters, dropout_rate, pad_idx=0):\n        super(TextCNN, self).__init__()\n\n        self.embedding = nn.Embedding(\n            num_embeddings=vocab_size,\n            embedding_dim=embed_dim,\n            padding_idx=pad_idx,\n        )\n\n        # 多通道卷积层\n        self.convs = nn.ModuleList([\n            nn.Conv1d(\n                in_channels=embed_dim,\n                out_channels=num_filters,\n                kernel_size=k,\n                padding=0,  # 不填充，让序列自然缩短\n            )\n            for k in kernel_sizes\n        ])\n\n        self.dropout = nn.Dropout(dropout_rate)\n        self.fc = nn.Linear(num_filters * len(kernel_sizes), num_classes)\n\n    def forward(self, x):\n        """\n        x: (batch_size, seq_len) 字符索引\n        """\n        # Embedding: (batch, seq_len) -> (batch, seq_len, embed_dim)\n        embedded = self.embedding(x)\n\n        # Conv1d 需要 (batch, channels, length) 格式\n        # (batch, seq_len, embed_dim) -> (batch, embed_dim, seq_len)\n        embedded = embedded.permute(0, 2, 1)\n\n        # 多通道卷积 + 激活 + 池化\n        conv_outputs = []\n        for conv in self.convs:\n            out = conv(embedded)          # (batch, num_filters, seq_len - k + 1)\n            out = torch.relu(out)\n            out = out.max(dim=2)[0]       # Max-over-time pooling: (batch, num_filters)\n            conv_outputs.append(out)\n\n        # 拼接所有通道: (batch, num_filters * len(kernel_sizes))\n        concatenated = torch.cat(conv_outputs, dim=1)\n\n        # Dropout + 全连接分类\n        out = self.dropout(concatenated)\n        logits = self.fc(out)             # (batch, num_classes)\n        return logits\n\n\n# ============================================================\n# 训练流程\n# ============================================================\ndef train_model(config):\n    """完整训练流程"""\n    print("=" * 60)\n    print("开始训练 CNN 新闻分类模型")\n    print("=" * 60)\n    print(f"设备: {config.device}")\n    print(f"配置: embed_dim={config.embed_dim}, filters={config.num_filters}, "\n          f"kernels={config.kernel_sizes}")\n    print(f"      batch_size={config.batch_size}, lr={config.learning_rate}, "\n          f"epochs={config.num_epochs}")\n    print()\n\n    # 1. 加载数据\n    print("[1/5] 加载数据...")\n    train_texts, train_labels = load_data(config.train_file)\n    dev_texts, dev_labels = load_data(config.dev_file)\n    print(f"  训练集: {len(train_texts)} 条")\n    print(f"  验证集: {len(dev_texts)} 条")\n\n    # 2. 构建词表\n    print("[2/5] 构建词表...")\n    vocab = build_vocab(train_texts, config.min_freq, config.vocab_max_size)\n\n    # 3. 创建 DataLoader\n    print("[3/5] 创建数据加载器...")\n    train_dataset = NewsDataset(train_texts, train_labels, vocab, config.max_seq_len)\n    dev_dataset = NewsDataset(dev_texts, dev_labels, vocab, config.max_seq_len)\n\n    train_loader = DataLoader(train_dataset, batch_size=config.batch_size,\n                              shuffle=True, num_workers=0)\n    dev_loader = DataLoader(dev_dataset, batch_size=config.batch_size,\n                            shuffle=False, num_workers=0)\n\n    # 4. 初始化模型\n    print("[4/5] 初始化模型...")\n    model = TextCNN(\n        vocab_size=len(vocab),\n        embed_dim=config.embed_dim,\n        num_classes=config.num_classes,\n        kernel_sizes=config.kernel_sizes,\n        num_filters=config.num_filters,\n        dropout_rate=config.dropout_rate,\n        pad_idx=0,\n    ).to(config.device)\n\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f"  模型参数量: {total_params:,} (可训练: {trainable_params:,})")\n\n    # 损失函数与优化器\n    criterion = nn.CrossEntropyLoss()\n    optimizer = optim.Adam(model.parameters(), lr=config.learning_rate)\n    scheduler = optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode="max", factor=0.5, patience=2, verbose=True\n    )\n\n    # 5. 训练循环\n    print("[5/5] 开始训练...")\n    print("-" * 60)\n\n    best_dev_acc = 0.0\n    patience_counter = 0\n    os.makedirs(config.output_dir, exist_ok=True)\n\n    for epoch in range(1, config.num_epochs + 1):\n        # --- 训练阶段 ---\n        model.train()\n        train_loss = 0.0\n        train_correct = 0\n        train_total = 0\n        epoch_start = time.time()\n\n        for batch_x, batch_y in train_loader:\n            batch_x = batch_x.to(config.device)\n            batch_y = batch_y.to(config.device)\n\n            optimizer.zero_grad()\n            logits = model(batch_x)\n            loss = criterion(logits, batch_y)\n            loss.backward()\n            # 梯度裁剪，防止梯度爆炸\n            nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            optimizer.step()\n\n            train_loss += loss.item() * batch_x.size(0)\n            _, predicted = logits.max(1)\n            train_total += batch_y.size(0)\n            train_correct += predicted.eq(batch_y).sum().item()\n\n        train_loss_avg = train_loss / train_total\n        train_acc = train_correct / train_total\n\n        # --- 验证阶段 ---\n        model.eval()\n        dev_loss = 0.0\n        dev_correct = 0\n        dev_total = 0\n\n        with torch.no_grad():\n            for batch_x, batch_y in dev_loader:\n                batch_x = batch_x.to(config.device)\n                batch_y = batch_y.to(config.device)\n\n                logits = model(batch_x)\n                loss = criterion(logits, batch_y)\n\n                dev_loss += loss.item() * batch_x.size(0)\n                _, predicted = logits.max(1)\n                dev_total += batch_y.size(0)\n                dev_correct += predicted.eq(batch_y).sum().item()\n\n        dev_loss_avg = dev_loss / dev_total\n        dev_acc = dev_correct / dev_total\n        epoch_time = time.time() - epoch_start\n\n        # 学习率调度\n        scheduler.step(dev_acc)\n\n        # 打印日志\n        print(f"Epoch {epoch:2d}/{config.num_epochs} | "\n              f"Train Loss: {train_loss_avg:.4f} Acc: {train_acc:.4f} | "\n              f"Dev Loss: {dev_loss_avg:.4f} Acc: {dev_acc:.4f} | "\n              f"Time: {epoch_time:.1f}s")\n\n        # 保存最佳模型\n        if dev_acc > best_dev_acc:\n            best_dev_acc = dev_acc\n            patience_counter = 0\n            save_dict = {\n                "model_state_dict": model.state_dict(),\n                "optimizer_state_dict": optimizer.state_dict(),\n                "vocab": vocab,\n                "config": {\n                    "embed_dim": config.embed_dim,\n                    "num_classes": config.num_classes,\n                    "kernel_sizes": config.kernel_sizes,\n                    "num_filters": config.num_filters,\n                    "dropout_rate": config.dropout_rate,\n                    "max_seq_len": config.max_seq_len,\n                    "vocab_size": len(vocab),\n                },\n                "dev_acc": best_dev_acc,\n                "epoch": epoch,\n            }\n            torch.save(save_dict, config.model_save_path)\n            print(f"  ✓ 保存最佳模型 (dev_acc={best_dev_acc:.4f})")\n        else:\n            patience_counter += 1\n            if patience_counter >= config.patience:\n                print(f"  ⚠ 连续 {config.patience} 个 epoch 无提升，提前停止训练")\n                break\n\n    print("-" * 60)\n    print(f"训练完成！最佳验证准确率: {best_dev_acc:.4f}")\n    print(f"模型已保存至: {config.model_save_path}")\n\n    # 加载类别名称\n    class_names = load_class_names(config.class_file)\n    print(f"类别映射: {dict(enumerate(class_names))}")\n\n    return best_dev_acc\n\n\n# ============================================================\n# 测试流程\n# ============================================================\ndef test_model(config):\n    """在测试集上评估已保存的模型"""\n    print("=" * 60)\n    print("开始测试 CNN 新闻分类模型")\n    print("=" * 60)\n\n    # 1. 加载模型\n    print(f"[1/3] 加载模型: {config.model_save_path}")\n    if not os.path.exists(config.model_save_path):\n        print("错误：模型文件不存在，请先运行训练模式！")\n        return\n\n    checkpoint = torch.load(config.model_save_path, map_location=config.device,\n                            weights_only=False)\n    vocab = checkpoint["vocab"]\n    model_config = checkpoint["config"]\n    print(f"  训练时最佳 dev_acc: {checkpoint[\'dev_acc\']:.4f} (epoch {checkpoint[\'epoch\']})")\n\n    # 重建模型\n    model = TextCNN(\n        vocab_size=model_config["vocab_size"],\n        embed_dim=model_config["embed_dim"],\n        num_classes=model_config["num_classes"],\n        kernel_sizes=model_config["kernel_sizes"],\n        num_filters=model_config["num_filters"],\n        dropout_rate=model_config["dropout_rate"],\n        pad_idx=0,\n    ).to(config.device)\n    model.load_state_dict(checkpoint["model_state_dict"])\n    model.eval()\n    print(f"  模型加载成功！")\n\n    # 2. 加载测试数据\n    print("[2/3] 加载测试数据...")\n    test_texts, test_labels = load_data(config.test_file)\n    print(f"  测试集: {len(test_texts)} 条")\n\n    test_dataset = NewsDataset(test_texts, test_labels, vocab, model_config["max_seq_len"])\n    test_loader = DataLoader(test_dataset, batch_size=config.batch_size,\n                             shuffle=False, num_workers=0)\n\n    # 3. 评估\n    print("[3/3] 评估中...")\n    class_names = load_class_names(config.class_file)\n    criterion = nn.CrossEntropyLoss()\n\n    total_loss = 0.0\n    total_correct = 0\n    total_count = 0\n\n    # 每个类别的统计\n    class_correct = [0] * config.num_classes\n    class_total = [0] * config.num_classes\n    all_preds = []\n    all_labels = []\n\n    with torch.no_grad():\n        for batch_x, batch_y in test_loader:\n            batch_x = batch_x.to(config.device)\n            batch_y = batch_y.to(config.device)\n\n            logits = model(batch_x)\n            loss = criterion(logits, batch_y)\n\n            _, predicted = logits.max(1)\n            total_loss += loss.item() * batch_x.size(0)\n            total_correct += predicted.eq(batch_y).sum().item()\n            total_count += batch_y.size(0)\n\n            all_preds.extend(predicted.cpu().tolist())\n            all_labels.extend(batch_y.cpu().tolist())\n\n            for i in range(batch_y.size(0)):\n                label = batch_y[i].item()\n                class_total[label] += 1\n                if predicted[i].item() == label:\n                    class_correct[label] += 1\n\n    # 打印总体结果\n    test_acc = total_correct / total_count\n    test_loss = total_loss / total_count\n    print()\n    print("-" * 60)\n    print(f"测试集总体结果:")\n    print(f"  Loss: {test_loss:.4f}")\n    print(f"  Accuracy: {test_acc:.4f} ({total_correct}/{total_count})")\n    print("-" * 60)\n\n    # 打印每个类别的结果\n    print(f"\\n{\'类别\':<15} {\'准确率\':<10} {\'正确/总数\':<15}")\n    print("-" * 40)\n    for i in range(config.num_classes):\n        if class_total[i] > 0:\n            acc = class_correct[i] / class_total[i]\n            name = class_names[i] if i < len(class_names) else f"class_{i}"\n            print(f"{name:<15} {acc:<10.4f} {class_correct[i]}/{class_total[i]}")\n\n    # 保存详细结果到文件\n    os.makedirs(config.output_dir, exist_ok=True)\n    with open(config.result_save_path, "w", encoding="utf-8") as f:\n        f.write("CNN 新闻分类模型 - 测试结果\\n")\n        f.write("=" * 60 + "\\n")\n        f.write(f"模型文件: {config.model_save_path}\\n")\n        f.write(f"训练最佳 dev_acc: {checkpoint[\'dev_acc\']:.4f}\\n")\n        f.write(f"测试集大小: {total_count}\\n")\n        f.write(f"总体准确率: {test_acc:.4f}\\n")\n        f.write(f"总体 Loss: {test_loss:.4f}\\n\\n")\n        f.write(f"{\'类别\':<15} {\'准确率\':<10} {\'正确/总数\':<15}\\n")\n        f.write("-" * 40 + "\\n")\n        for i in range(config.num_classes):\n            if class_total[i] > 0:\n                acc = class_correct[i] / class_total[i]\n                name = class_names[i] if i < len(class_names) else f"class_{i}"\n                f.write(f"{name:<15} {acc:<10.4f} {class_correct[i]}/{class_total[i]}\\n")\n\n        # 保存混淆矩阵数据（JSON 格式，方便后续分析）\n        f.write("\\n\\n--- 混淆矩阵数据 (JSON) ---\\n")\n        confusion_data = {\n            "preds": all_preds,\n            "labels": all_labels,\n            "class_names": class_names,\n        }\n        confusion_path = os.path.join(config.output_dir, "confusion_data.json")\n        with open(confusion_path, "w", encoding="utf-8") as cf:\n            json.dump(confusion_data, cf, ensure_ascii=False, indent=2)\n        f.write(f"混淆矩阵数据已保存至: {confusion_path}\\n")\n\n    print(f"\\n测试结果已保存至: {config.result_save_path}")\n    return test_acc\n\n\n# ============================================================\n# 单条预测\n# ============================================================\ndef predict_text(config, text):\n    """使用已训练模型对单条文本进行分类预测"""\n    # 加载模型\n    if not os.path.exists(config.model_save_path):\n        print("错误：模型文件不存在，请先运行训练模式！")\n        return\n\n    checkpoint = torch.load(config.model_save_path, map_location=config.device,\n                            weights_only=False)\n    vocab = checkpoint["vocab"]\n    model_config = checkpoint["config"]\n    class_names = load_class_names(config.class_file)\n\n    model = TextCNN(\n        vocab_size=model_config["vocab_size"],\n        embed_dim=model_config["embed_dim"],\n        num_classes=model_config["num_classes"],\n        kernel_sizes=model_config["kernel_sizes"],\n        num_filters=model_config["num_filters"],\n        dropout_rate=model_config["dropout_rate"],\n        pad_idx=0,\n    ).to(config.device)\n    model.load_state_dict(checkpoint["model_state_dict"])\n    model.eval()\n\n    # 编码并预测\n    ids = encode_text(text, vocab, model_config["max_seq_len"])\n    input_tensor = torch.tensor([ids], dtype=torch.long).to(config.device)\n\n    with torch.no_grad():\n        logits = model(input_tensor)\n        probs = torch.softmax(logits, dim=1)\n        pred_class = probs.argmax(dim=1).item()\n        pred_prob = probs[0][pred_class].item()\n\n    print(f"\\n输入文本: {text}")\n    print(f"预测类别: {class_names[pred_class]} (编号: {pred_class})")\n    print(f"置信度:   {pred_prob:.4f}")\n\n    # 显示 top-3 概率\n    top_k = min(3, config.num_classes)\n    top_probs, top_indices = probs[0].topk(top_k)\n    print(f"\\nTop-{top_k} 预测:")\n    for prob, idx in zip(top_probs, top_indices):\n        print(f"  {class_names[idx.item()]:<15} {prob.item():.4f}")\n\n\n# ============================================================\n# 工具函数\n# ============================================================\ndef load_class_names(class_file):\n    """加载类别名称列表"""\n    with open(class_file, "r", encoding="utf-8") as f:\n        return [line.strip() for line in f if line.strip()]\n\n\n# ============================================================\n# 主入口\n# ============================================================\ndef main():\n    parser = argparse.ArgumentParser(description="CNN 新闻标题分类器")\n    parser.add_argument(\n        "--mode",\n        type=str,\n        choices=["train", "test", "predict"],\n        default="train",\n        help="运行模式: train(训练), test(测试), predict(单条预测)",\n    )\n    parser.add_argument(\n        "--text",\n        type=str,\n        default="",\n        help="预测模式下的输入文本",\n    )\n    parser.add_argument("--epochs", type=int, default=20, help="训练轮数")\n    parser.add_argument("--batch_size", type=int, default=128, help="批次大小")\n    parser.add_argument("--lr", type=float, default=1e-3, help="学习率")\n    parser.add_argument("--embed_dim", type=int, default=256, help="词嵌入维度")\n    parser.add_argument("--num_filters", type=int, default=256, help="卷积通道数")\n    parser.add_argument("--max_seq_len", type=int, default=64, help="最大序列长度")\n    parser.add_argument("--dropout", type=float, default=0.3, help="Dropout 比率")\n    parser.add_argument("--patience", type=int, default=5, help="早停耐心值")\n\n    args = parser.parse_args()\n\n    config = Config()\n    # 用命令行参数覆盖配置\n    config.num_epochs = args.epochs\n    config.batch_size = args.batch_size\n    config.learning_rate = args.lr\n    config.embed_dim = args.embed_dim\n    config.num_filters = args.num_filters\n    config.max_seq_len = args.max_seq_len\n    config.dropout_rate = args.dropout\n    config.patience = args.patience\n\n    if args.mode == "train":\n        train_model(config)\n    elif args.mode == "test":\n        test_model(config)\n    elif args.mode == "predict":\n        if not args.text:\n            print("错误：预测模式需要指定 --text 参数")\n            print(\'示例: python cnn_classifier.py --mode predict --text "今日股市大涨"\')\n        else:\n            predict_text(config, args.text)\n\n\nif __name__ == "__main__":\n    main()\n'}}], 'finish_reason': 'tool_calls'}
