20260615 20:26:33 - MainProcess | MainThread | runtime._execute_step:513 - DEBUG -{'content': '', 'tool_calls': [{'id': 'call_04e888601d554cce8c3e9854', 'name': 'write_file', 'arguments': {'path': '', 'content': '# -*- coding: utf-8 -*-\n"""\n可复用的搜狐新闻 XML 文本提取模块\n支持从 XML 格式的新闻文件中提取 content 和 contenttitle 字段\n"""\n\nimport re\nimport os\nimport glob\nfrom typing import List, Dict, Optional\n\n\ndef parse_single_xml(file_path: str,\n                      extract_fields: Optional[List[str]] = None,\n                      min_content_len: int = 10) -> List[Dict[str, str]]:\n    """\n    解析单个 XML 新闻文件，提取指定字段\n\n    Parameters:\n        file_path: XML 文件路径\n        extract_fields: 要提取的字段列表，默认 [\'content\', \'contenttitle\']\n        min_content_len: content 最小长度过滤，低于此长度的文档会被跳过\n\n    Returns:\n        文档列表，每个文档为 dict，包含 url, docno, contenttitle, content\n    """\n    if extract_fields is None:\n        extract_fields = [\'content\', \'contenttitle\']\n\n    with open(file_path, \'r\', encoding=\'utf-8\') as f:\n        raw_text = f.read()\n\n    # 按 <doc>...</doc> 分割\n    doc_pattern = re.compile(r\'<doc>(.*?)</doc>\', re.DOTALL)\n    docs = doc_pattern.findall(raw_text)\n\n    results = []\n    for doc_text in docs:\n        record = {}\n\n        # 提取 url\n        url_match = re.search(r\'<url>(.*?)</url>\', doc_text, re.DOTALL)\n        record[\'url\'] = url_match.group(1).strip() if url_match else \'\'\n\n        # 提取 docno\n        docno_match = re.search(r\'<docno>(.*?)</docno>\', doc_text, re.DOTALL)\n        record[\'docno\'] = docno_match.group(1).strip() if docno_match else \'\'\n\n        # 提取 contenttitle\n        if \'contenttitle\' in extract_fields:\n            title_match = re.search(r\'<contenttitle>(.*?)</contenttitle>\', doc_text, re.DOTALL)\n            record[\'contenttitle\'] = title_match.group(1).strip() if title_match else \'\'\n\n        # 提取 content\n        if \'content\' in extract_fields:\n            content_match = re.search(r\'<content>(.*?)</content>\', doc_text, re.DOTALL)\n            record[\'content\'] = content_match.group(1).strip() if content_match else \'\'\n\n        # 过滤空文档或过短文档\n        content = record.get(\'content\', \'\')\n        if len(content) < min_content_len:\n            continue\n\n        results.append(record)\n\n    return results\n\n\ndef parse_batch_files(data_dir: str,\n                      file_pattern: str = \'*.txt\',\n                      extract_fields: Optional[List[str]] = None,\n                      min_content_len: int = 10) -> List[Dict[str, str]]:\n    """\n    批量解析目录下所有 XML 新闻文件\n\n    Parameters:\n        data_dir: 数据目录路径\n        file_pattern: 文件匹配模式，默认 \'*.txt\'\n        extract_fields: 要提取的字段列表\n        min_content_len: content 最小长度过滤\n\n    Returns:\n        所有文档的列表\n    """\n    all_docs = []\n    file_paths = sorted(glob.glob(os.path.join(data_dir, file_pattern)))\n\n    if not file_paths:\n        print(f"[警告] 目录 {data_dir} 下未找到匹配 {file_pattern} 的文件")\n        return all_docs\n\n    for fp in file_paths:\n        docs = parse_single_xml(fp, extract_fields, min_content_len)\n        print(f"  解析 {os.path.basename(fp)}: 提取 {len(docs)} 条文档")\n        all_docs.extend(docs)\n\n    print(f"  共提取 {len(all_docs)} 条文档")\n    return all_docs\n\n\ndef get_text_for_modeling(docs: List[Dict[str, str]],\n                          use_title: bool = True,\n                          use_content: bool = True) -> List[str]:\n    """\n    将提取的文档列表转换为用于建模的纯文本列表\n    可选择拼接 title + content\n\n    Parameters:\n        docs: parse_single_xml 或 parse_batch_files 返回的文档列表\n        use_title: 是否包含标题\n        use_content: 是否包含正文\n\n    Returns:\n        文本列表\n    """\n    texts = []\n    for doc in docs:\n        parts = []\n        if use_title and doc.get(\'contenttitle\'):\n            parts.append(doc[\'contenttitle\'])\n        if use_content and doc.get(\'content\'):\n            parts.append(doc[\'content\'])\n        combined = \' \'.join(parts).strip()\n        if combined:\n            texts.append(combined)\n    return texts\n\n\n# ============ 直接运行测试 ============\nif __name__ == \'__main__\':\n    import sys\n\n    data_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), \'news_data\')\n\n    if len(sys.argv) > 1:\n        # 指定单个文件\n        docs = parse_single_xml(sys.argv[1])\n    else:\n        # 批量解析\n        docs = parse_batch_files(data_dir)\n\n    print(f"\\n前 3 条文档预览:")\n    for i, doc in enumerate(docs[:3]):\n        print(f"\\n--- 文档 {i+1} ---")\n        print(f"  标题: {doc.get(\'contenttitle\', \'\')[:80]}")\n        print(f"  正文: {doc.get(\'content\', \'\')[:150]}...")\n        print(f"  URL: {doc.get(\'url\', \'\')}")\n'}}], 'finish_reason': 'tool_calls'}
