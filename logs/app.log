20260615 21:03:09 - MainProcess | MainThread | runtime._execute_step:513 - DEBUG -{'content': '', 'tool_calls': [{'id': 'call_c4975e66430b4896b2893f8b', 'name': 'write_file', 'arguments': {'path': 'xml_parser.py', 'content': '# -*- coding: utf-8 -*-\n"""\nxml_parser.py - 搜狐新闻 XML 文本提取模块（可复用）\n\n功能：\n    解析搜狐新闻 XML 格式文件，提取 content 和 contenttitle 字段。\n    支持单文件解析和批量文件解析。\n\n使用方式：\n    # 单文件解析\n    from xml_parser import parse_single_file\n    docs = parse_single_file("news_data/news.sohunews.010806.txt")\n\n    # 批量文件解析\n    from xml_parser import parse_all_files\n    docs = parse_all_files("news_data/")\n\n    # 返回格式：[{"title": ..., "content": ..., "url": ..., "docno": ...}, ...]\n"""\n\nimport os\nimport re\nimport glob\nfrom xml.etree import ElementTree as ET\n\n\ndef _clean_text(text):\n    """清理文本中的特殊字符和多余空白"""\n    if not text:\n        return ""\n    # 去除首尾空白\n    text = text.strip()\n    # 将全角数字/字母转为半角（可选，视需求）\n    # 去除多余空白行\n    text = re.sub(r\'\\n{3,}\', \'\\n\\n\', text)\n    return text\n\n\ndef parse_single_file(file_path, encoding=\'utf-8\'):\n    """\n    解析单个搜狐新闻 XML 文件，提取所有文档信息。\n\n    参数:\n        file_path (str): XML 文件路径\n        encoding (str): 文件编码，默认 utf-8\n\n    返回:\n        list[dict]: 文档列表，每个文档包含 title, content, url, docno\n    """\n    docs = []\n\n    # 先尝试读取文件内容\n    with open(file_path, \'r\', encoding=encoding, errors=\'replace\') as f:\n        content = f.read()\n\n    # 搜狐新闻 XML 不是标准 XML（没有根节点），需要包装\n    # 用正则逐条提取 <doc>...</doc> 块\n    doc_pattern = re.compile(r\'<doc>(.*?)</doc>\', re.DOTALL)\n    doc_blocks = doc_pattern.findall(content)\n\n    for block in doc_blocks:\n        doc = {}\n\n        # 提取 contenttitle\n        title_match = re.search(r\'<contenttitle>(.*?)</contenttitle>\', block, re.DOTALL)\n        doc[\'title\'] = _clean_text(title_match.group(1)) if title_match else ""\n\n        # 提取 content\n        content_match = re.search(r\'<content>(.*?)</content>\', block, re.DOTALL)\n        doc[\'content\'] = _clean_text(content_match.group(1)) if content_match else ""\n\n        # 提取 url\n        url_match = re.search(r\'<url>(.*?)</url>\', block, re.DOTALL)\n        doc[\'url\'] = _clean_text(url_match.group(1)) if url_match else ""\n\n        # 提取 docno\n        docno_match = re.search(r\'<docno>(.*?)</docno>\', block, re.DOTALL)\n        doc[\'docno\'] = _clean_text(docno_match.group(1)) if docno_match else ""\n\n        # 过滤掉 content 为空的文档\n        if doc[\'content\']:\n            docs.append(doc)\n\n    return docs\n\n\ndef parse_all_files(data_dir, pattern="*.txt", encoding=\'utf-8\'):\n    """\n    批量解析目录下所有搜狐新闻 XML 文件。\n\n    参数:\n        data_dir (str): 数据目录路径\n        pattern (str): 文件匹配模式，默认 *.txt\n        encoding (str): 文件编码，默认 utf-8\n\n    返回:\n        list[dict]: 所有文档列表\n    """\n    all_docs = []\n    file_pattern = os.path.join(data_dir, pattern)\n    files = sorted(glob.glob(file_pattern))\n\n    if not files:\n        print(f"[警告] 目录 {data_dir} 下未找到匹配 {pattern} 的文件")\n        return all_docs\n\n    for file_path in files:\n        print(f"[解析] {os.path.basename(file_path)} ...", end=" ")\n        docs = parse_single_file(file_path, encoding=encoding)\n        print(f"提取 {len(docs)} 条文档")\n        all_docs.extend(docs)\n\n    print(f"\\n[完成] 共解析 {len(files)} 个文件，提取 {len(all_docs)} 条文档")\n    return all_docs\n\n\ndef get_texts_only(docs):\n    """\n    从文档列表中提取纯文本内容（content），用于后续分词和建模。\n\n    参数:\n        docs (list[dict]): parse_single_file 或 parse_all_files 的返回结果\n\n    返回:\n        list[str]: 文本内容列表\n    """\n    return [doc[\'content\'] for doc in docs if doc.get(\'content\')]\n\n\ndef get_title_and_content(docs):\n    """\n    从文档列表中提取标题+内容的组合文本。\n\n    参数:\n        docs (list[dict]): parse_single_file 或 parse_all_files 的返回结果\n\n    返回:\n        list[str]: 标题+内容组合文本列表\n    """\n    texts = []\n    for doc in docs:\n        combined = f"{doc.get(\'title\', \'\')} {doc.get(\'content\', \'\')}".strip()\n        if combined:\n            texts.append(combined)\n    return texts\n\n\n# ============ 独立运行测试 ============\nif __name__ == "__main__":\n    import sys\n\n    # 默认数据目录\n    data_dir = os.path.join(os.path.dirname(os.path.abspath(__file__)), "news_data")\n\n    if len(sys.argv) > 1:\n        data_dir = sys.argv[1]\n\n    print(f"数据目录: {data_dir}")\n    print("=" * 60)\n\n    # 批量解析\n    docs = parse_all_files(data_dir)\n\n    # 展示前 3 条\n    print("\\n" + "=" * 60)\n    print("前 3 条文档预览:")\n    print("=" * 60)\n    for i, doc in enumerate(docs[:3]):\n        print(f"\\n--- 文档 {i+1} ---")\n        print(f"标题: {doc[\'title\'][:80]}")\n        print(f"内容: {doc[\'content\'][:200]}...")\n        print(f"URL: {doc[\'url\']}")\n'}}], 'finish_reason': 'tool_calls'}
