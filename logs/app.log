20260621 09:45:38 - MainProcess | MainThread | runtime._execute_step:513 - DEBUG -{'content': '现在我对数据结构完全了解了：\n\n- **class.txt**：10个类别（finance, realty, stocks, education, science, society, politics, sports, game, entertainment）\n- **train.txt**：~18万条，格式 `标题\\t类别编号`\n- **test.txt / dev.txt**：各~1万条，同样格式\n- 中文新闻标题分类任务\n\n接下来我编写完整的 CNN 训练/测试代码：\n\n', 'tool_calls': [{'id': 'call_1296b75d5950428eac4f95a2', 'name': 'write_file', 'arguments': {'path': 'cnn_classifier.py', 'content': '"""\n中文新闻标题 CNN 分类器 (PyTorch)\n===================================\n功能：\n  1. 训练模式：读取 train.txt 训练 CNN 模型，用 dev.txt 验证，保存最佳模型\n  2. 测试模式：加载已保存的模型，在 test.txt 上评估并输出分类报告\n\n用法：\n  训练：python cnn_classifier.py --mode train\n  测试：python cnn_classifier.py --mode test\n"""\n\nimport os\nimport time\nimport argparse\nimport pickle\nfrom collections import Counter\n\nimport numpy as np\nimport torch\nimport torch.nn as nn\nimport torch.optim as optim\nfrom torch.utils.data import Dataset, DataLoader\nfrom torch.nn.utils.rnn import pad_sequence\n\n# ============================================================\n# 配置参数\n# ============================================================\nclass Config:\n    # 路径\n    DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")\n    OUTPUT_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "output")\n\n    TRAIN_FILE = os.path.join(DATA_DIR, "train.txt")\n    DEV_FILE   = os.path.join(DATA_DIR, "dev.txt")\n    TEST_FILE  = os.path.join(DATA_DIR, "test.txt")\n    CLASS_FILE = os.path.join(DATA_DIR, "class.txt")\n\n    MODEL_SAVE_PATH = os.path.join(OUTPUT_DIR, "cnn_news_model.pt")\n    VOCAB_SAVE_PATH = os.path.join(OUTPUT_DIR, "vocab.pkl")\n    CONFIG_SAVE_PATH = os.path.join(OUTPUT_DIR, "model_config.pkl")\n\n    # 数据\n    MAX_SEQ_LEN = 60        # 标题最大字符数（截断/填充）\n    MIN_FREQ = 1            # 词频阈值，低于此值的字符映射为 <UNK>\n\n    # 模型\n    EMBED_DIM = 256         # 字符嵌入维度\n    NUM_FILTERS = 256       # 每种卷积核的数量\n    FILTER_SIZES = [2, 3, 4, 5]  # 多种卷积核大小（捕获 2-gram ~ 5-gram）\n    DROPOUT = 0.3\n    NUM_CLASSES = 10\n\n    # 训练\n    BATCH_SIZE = 128\n    EPOCHS = 15\n    LR = 1e-3\n    WEIGHT_DECAY = 1e-4\n    PATIENCE = 3            # 早停耐心值\n    DEVICE = "cuda" if torch.cuda.is_available() else "cpu"\n\n\n# ============================================================\n# 数据加载\n# ============================================================\ndef load_data(file_path):\n    """\n    加载数据文件，返回 (texts, labels)\n    格式：每行 "标题\\t类别编号"\n    """\n    texts, labels = [], []\n    with open(file_path, "r", encoding="utf-8") as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.rsplit("\\t", 1)\n            if len(parts) != 2:\n                continue\n            text, label = parts[0], int(parts[1])\n            texts.append(text)\n            labels.append(label)\n    return texts, labels\n\n\ndef load_class_names(file_path):\n    """加载类别名称列表"""\n    with open(file_path, "r", encoding="utf-8") as f:\n        return [line.strip() for line in f if line.strip()]\n\n\n# ============================================================\n# 字符级 Vocabulary\n# ============================================================\nclass CharVocab:\n    """字符级词汇表：将中文字符映射为索引"""\n\n    PAD_TOKEN = "<PAD>"\n    UNK_TOKEN = "<UNK>"\n\n    def __init__(self, min_freq=1):\n        self.min_freq = min_freq\n        self.char2idx = {}\n        self.idx2char = {}\n        self.pad_idx = 0\n        self.unk_idx = 1\n\n    def build(self, texts):\n        """从文本列表构建词汇表"""\n        counter = Counter()\n        for text in texts:\n            counter.update(text)\n\n        # 先加入特殊 token\n        self.char2idx[self.PAD_TOKEN] = 0\n        self.char2idx[self.UNK_TOKEN] = 1\n        idx = 2\n\n        for char, freq in counter.most_common():\n            if freq >= self.min_freq:\n                self.char2idx[char] = idx\n                idx += 1\n\n        self.idx2char = {v: k for k, v in self.char2idx.items()}\n        print(f"[Vocab] 词汇表大小: {len(self.char2idx)} (含 <PAD>, <UNK>)")\n\n    def encode(self, text, max_len):\n        """将文本编码为索引列表（固定长度）"""\n        chars = list(text[:max_len])\n        indices = [self.char2idx.get(c, self.unk_idx) for c in chars]\n        # 填充到 max_len\n        pad_len = max_len - len(indices)\n        indices += [self.pad_idx] * pad_len\n        return indices\n\n    def __len__(self):\n        return len(self.char2idx)\n\n\n# ============================================================\n# Dataset\n# ============================================================\nclass NewsDataset(Dataset):\n    def __init__(self, texts, labels, vocab, max_seq_len):\n        self.texts = texts\n        self.labels = labels\n        self.vocab = vocab\n        self.max_seq_len = max_seq_len\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        x = self.vocab.encode(self.texts[idx], self.max_seq_len)\n        y = self.labels[idx]\n        return torch.tensor(x, dtype=torch.long), torch.tensor(y, dtype=torch.long)\n\n\n# ============================================================\n# CNN 模型\n# ============================================================\nclass TextCNN(nn.Module):\n    """\n    多通道 TextCNN：\n    - Embedding 层\n    - 多种尺寸的 1D 卷积核并行提取特征\n    - 1D Max-over-time pooling\n    - 拼接 → Dropout → FC\n    """\n\n    def __init__(self, vocab_size, embed_dim, num_filters, filter_sizes,\n                 num_classes, dropout, pad_idx=0):\n        super().__init__()\n\n        self.embedding = nn.Embedding(vocab_size, embed_dim, padding_idx=pad_idx)\n\n        # 多通道卷积\n        self.convs = nn.ModuleList([\n            nn.Conv1d(in_channels=embed_dim,\n                      out_channels=num_filters,\n                      kernel_size=fs,\n                      padding=0)\n            for fs in filter_sizes\n        ])\n\n        self.dropout = nn.Dropout(dropout)\n        self.fc = nn.Linear(num_filters * len(filter_sizes), num_classes)\n\n    def forward(self, x):\n        """\n        x: (batch_size, seq_len)  字符索引\n        """\n        # Embedding: (batch, seq_len) -> (batch, seq_len, embed_dim)\n        embedded = self.embedding(x)\n\n        # Conv1d 需要 (batch, channels, length)\n        # -> (batch, embed_dim, seq_len)\n        embedded = embedded.permute(0, 2, 1)\n\n        # 多通道卷积 + ReLU + Max-over-time pooling\n        conv_outputs = []\n        for conv in self.convs:\n            out = conv(embedded)          # (batch, num_filters, seq_len - kernel_size + 1)\n            out = torch.relu(out)\n            out = out.max(dim=2)[0]       # (batch, num_filters)  max-over-time\n            conv_outputs.append(out)\n\n        # 拼接所有通道: (batch, num_filters * len(filter_sizes))\n        cat = torch.cat(conv_outputs, dim=1)\n        cat = self.dropout(cat)\n\n        # 分类\n        logits = self.fc(cat)             # (batch, num_classes)\n        return logits\n\n\n# ============================================================\n# 训练流程\n# ============================================================\ndef train_model(config):\n    print("=" * 60)\n    print("  CNN 新闻标题分类器 - 训练模式")\n    print(f"  设备: {config.DEVICE}")\n    print("=" * 60)\n\n    os.makedirs(config.OUTPUT_DIR, exist_ok=True)\n\n    # 1. 加载数据\n    print("\\n[1/6] 加载数据...")\n    train_texts, train_labels = load_data(config.TRAIN_FILE)\n    dev_texts, dev_labels = load_data(config.DEV_FILE)\n    class_names = load_class_names(config.CLASS_FILE)\n    print(f"  训练集: {len(train_texts)} 条")\n    print(f"  验证集: {len(dev_texts)} 条")\n    print(f"  类别数: {len(class_names)}")\n\n    # 2. 构建词汇表\n    print("\\n[2/6] 构建词汇表...")\n    vocab = CharVocab(min_freq=config.MIN_FREQ)\n    vocab.build(train_texts)\n\n    # 保存词汇表\n    with open(config.VOCAB_SAVE_PATH, "wb") as f:\n        pickle.dump(vocab, f)\n    print(f"  词汇表已保存: {config.VOCAB_SAVE_PATH}")\n\n    # 3. 创建 Dataset & DataLoader\n    print("\\n[3/6] 创建数据加载器...")\n    train_dataset = NewsDataset(train_texts, train_labels, vocab, config.MAX_SEQ_LEN)\n    dev_dataset = NewsDataset(dev_texts, dev_labels, vocab, config.MAX_SEQ_LEN)\n\n    train_loader = DataLoader(train_dataset, batch_size=config.BATCH_SIZE,\n                              shuffle=True, num_workers=0)\n    dev_loader = DataLoader(dev_dataset, batch_size=config.BATCH_SIZE,\n                            shuffle=False, num_workers=0)\n\n    # 4. 初始化模型\n    print("\\n[4/6] 初始化模型...")\n    model = TextCNN(\n        vocab_size=len(vocab),\n        embed_dim=config.EMBED_DIM,\n        num_filters=config.NUM_FILTERS,\n        filter_sizes=config.FILTER_SIZES,\n        num_classes=config.NUM_CLASSES,\n        dropout=config.DROPOUT,\n        pad_idx=vocab.pad_idx\n    ).to(config.DEVICE)\n\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f"  总参数量: {total_params:,}")\n    print(f"  可训练参数: {trainable_params:,}")\n    print(f"  模型结构:\\n{model}")\n\n    # 5. 损失函数 & 优化器\n    criterion = nn.CrossEntropyLoss()\n    optimizer = optim.Adam(model.parameters(), lr=config.LR, weight_decay=config.WEIGHT_DECAY)\n    scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode=\'max\', factor=0.5,\n                                                      patience=2, verbose=True)\n\n    # 6. 训练循环\n    print("\\n[5/6] 开始训练...")\n    print("-" * 60)\n    best_dev_acc = 0.0\n    patience_counter = 0\n    history = {"train_loss": [], "train_acc": [], "dev_loss": [], "dev_acc": []}\n\n    for epoch in range(1, config.EPOCHS + 1):\n        start_time = time.time()\n\n        # ---- 训练 ----\n        model.train()\n        train_loss, train_correct, train_total = 0.0, 0, 0\n\n        for batch_x, batch_y in train_loader:\n            batch_x = batch_x.to(config.DEVICE)\n            batch_y = batch_y.to(config.DEVICE)\n\n            optimizer.zero_grad()\n            logits = model(batch_x)\n            loss = criterion(logits, batch_y)\n            loss.backward()\n            nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            optimizer.step()\n\n            train_loss += loss.item() * batch_x.size(0)\n            preds = logits.argmax(dim=1)\n            train_correct += (preds == batch_y).sum().item()\n            train_total += batch_x.size(0)\n\n        avg_train_loss = train_loss / train_total\n        avg_train_acc = train_correct / train_total\n\n        # ---- 验证 ----\n        model.eval()\n        dev_loss, dev_correct, dev_total = 0.0, 0, 0\n\n        with torch.no_grad():\n            for batch_x, batch_y in dev_loader:\n                batch_x = batch_x.to(config.DEVICE)\n                batch_y = batch_y.to(config.DEVICE)\n\n                logits = model(batch_x)\n                loss = criterion(logits, batch_y)\n\n                dev_loss += loss.item() * batch_x.size(0)\n                preds = logits.argmax(dim=1)\n                dev_correct += (preds == batch_y).sum().item()\n                dev_total += batch_x.size(0)\n\n        avg_dev_loss = dev_loss / dev_total\n        avg_dev_acc = dev_correct / dev_total\n\n        elapsed = time.time() - start_time\n        scheduler.step(avg_dev_acc)\n\n        # 记录历史\n        history["train_loss"].append(avg_train_loss)\n        history["train_acc"].append(avg_train_acc)\n        history["dev_loss"].append(avg_dev_loss)\n        history["dev_acc"].append(avg_dev_acc)\n\n        print(f"  Epoch {epoch:02d}/{config.EPOCHS} | "\n              f"Train Loss: {avg_train_loss:.4f} Acc: {avg_train_acc:.4f} | "\n              f"Dev Loss: {avg_dev_loss:.4f} Acc: {avg_dev_acc:.4f} | "\n              f"Time: {elapsed:.1f}s")\n\n        # 保存最佳模型\n        if avg_dev_acc > best_dev_acc:\n            best_dev_acc = avg_dev_acc\n            patience_counter = 0\n            torch.save({\n                "epoch": epoch,\n                "model_state_dict": model.state_dict(),\n                "optimizer_state_dict": optimizer.state_dict(),\n                "dev_acc": avg_dev_acc,\n                "config": {\n                    "vocab_size": len(vocab),\n                    "embed_dim": config.EMBED_DIM,\n                    "num_filters": config.NUM_FILTERS,\n                    "filter_sizes": config.FILTER_SIZES,\n                    "num_classes": config.NUM_CLASSES,\n                    "dropout": config.DROPOUT,\n                    "max_seq_len": config.MAX_SEQ_LEN,\n                }\n            }, config.MODEL_SAVE_PATH)\n            print(f"    ★ 最佳模型已保存 (dev_acc={avg_dev_acc:.4f})")\n        else:\n            patience_counter += 1\n            if patience_counter >= config.PATIENCE:\n                print(f"    ⚠ 连续 {config.PATIENCE} 轮无提升，提前停止训练")\n                break\n\n    # 7. 保存训练配置\n    with open(config.CONFIG_SAVE_PATH, "wb") as f:\n        pickle.dump({\n            "max_seq_len": config.MAX_SEQ_LEN,\n            "num_classes": config.NUM_CLASSES,\n            "class_names": class_names,\n        }, f)\n\n    print("\\n" + "=" * 60)\n    print(f"  训练完成！最佳验证准确率: {best_dev_acc:.4f}")\n    print(f"  模型文件: {config.MODEL_SAVE_PATH}")\n    print(f"  词汇表:   {config.VOCAB_SAVE_PATH}")\n    print(f"  配置:     {config.CONFIG_SAVE_PATH}")\n    print("=" * 60)\n\n    return model, vocab, history\n\n\n# ============================================================\n# 测试/评估流程\n# ============================================================\ndef test_model(config):\n    print("=" * 60)\n    print("  CNN 新闻标题分类器 - 测试模式")\n    print(f"  设备: {config.DEVICE}")\n    print("=" * 60)\n\n    # 1. 加载词汇表\n    print("\\n[1/4] 加载词汇表和配置...")\n    with open(config.VOCAB_SAVE_PATH, "rb") as f:\n        vocab = pickle.load(f)\n    with open(config.CONFIG_SAVE_PATH, "rb") as f:\n        model_config = pickle.load(f)\n\n    class_names = model_config["class_names"]\n    max_seq_len = model_config["max_seq_len"]\n    print(f"  词汇表大小: {len(vocab)}")\n    print(f"  类别: {class_names}")\n\n    # 2. 加载模型\n    print("\\n[2/4] 加载模型...")\n    checkpoint = torch.load(config.MODEL_SAVE_PATH, map_location=config.DEVICE)\n    saved_config = checkpoint["config"]\n\n    model = TextCNN(\n        vocab_size=saved_config["vocab_size"],\n        embed_dim=saved_config["embed_dim"],\n        num_filters=saved_config["num_filters"],\n        filter_sizes=saved_config["filter_sizes"],\n        num_classes=saved_config["num_classes"],\n        dropout=saved_config["dropout"],\n        pad_idx=vocab.pad_idx\n    ).to(config.DEVICE)\n\n    model.load_state_dict(checkpoint["model_state_dict"])\n    model.eval()\n    print(f"  模型加载成功 (训练于 Epoch {checkpoint[\'epoch\']}, "\n          f"Dev Acc: {checkpoint[\'dev_acc\']:.4f})")\n\n    # 3. 加载测试数据\n    print("\\n[3/4] 加载测试数据...")\n    test_texts, test_labels = load_data(config.TEST_FILE)\n    test_dataset = NewsDataset(test_texts, test_labels, vocab, max_seq_len)\n    test_loader = DataLoader(test_dataset, batch_size=config.BATCH_SIZE,\n                             shuffle=False, num_workers=0)\n    print(f"  测试集: {len(test_texts)} 条")\n\n    # 4. 评估\n    print("\\n[4/4] 开始评估...")\n    all_preds = []\n    all_labels = []\n    all_probs = []\n\n    with torch.no_grad():\n        for batch_x, batch_y in test_loader:\n            batch_x = batch_x.to(config.DEVICE)\n            logits = model(batch_x)\n            probs = torch.softmax(logits, dim=1)\n            preds = logits.argmax(dim=1)\n\n            all_preds.extend(preds.cpu().numpy().tolist())\n            all_labels.extend(batch_y.numpy().tolist())\n            all_probs.extend(probs.cpu().numpy().tolist())\n\n    all_preds = np.array(all_preds)\n    all_labels = np.array(all_labels)\n    all_probs = np.array(all_probs)\n\n    # ---- 总体准确率 ----\n    accuracy = (all_preds == all_labels).mean()\n    print(f"\\n{\'=\' * 60}")\n    print(f"  测试集总体准确率: {accuracy:.4f} ({(all_preds == all_labels).sum()}/{len(all_labels)})")\n    print(f"{\'=\' * 60}")\n\n    # ---- 每个类别的指标 ----\n    print(f"\\n{\'类别\':<15} {\'Precision\':>10} {\'Recall\':>10} {\'F1\':>10} {\'Support\':>10}")\n    print("-" * 60)\n\n    macro_p, macro_r, macro_f1 = 0.0, 0.0, 0.0\n    for cls_id in range(config.NUM_CLASSES):\n        tp = ((all_preds == cls_id) & (all_labels == cls_id)).sum()\n        fp = ((all_preds == cls_id) & (all_labels != cls_id)).sum()\n        fn = ((all_preds != cls_id) & (all_labels == cls_id)).sum()\n        support = (all_labels == cls_id).sum()\n\n        precision = tp / (tp + fp) if (tp + fp) > 0 else 0.0\n        recall = tp / (tp + fn) if (tp + fn) > 0 else 0.0\n        f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0.0\n\n        macro_p += precision\n        macro_r += recall\n        macro_f1 += f1\n\n        cls_name = class_names[cls_id] if cls_id < len(class_names) else f"class_{cls_id}"\n        print(f"  {cls_name:<13} {precision:>10.4f} {recall:>10.4f} {f1:>10.4f} {support:>10}")\n\n    print("-" * 60)\n    n_classes = config.NUM_CLASSES\n    print(f"  {\'Macro Avg\':<13} {macro_p/n_classes:>10.4f} {macro_r/n_classes:>10.4f} {macro_f1/n_classes:>10.4f}")\n    print(f"  {\'Micro Avg\':<13} {accuracy:>10.4f} {accuracy:>10.4f} {accuracy:>10.4f}")\n\n    # ---- 混淆矩阵 ----\n    print(f"\\n混淆矩阵 (行=真实, 列=预测):")\n    print(f"{\'\':>13}", end="")\n    for cls_id in range(config.NUM_CLASSES):\n        short_name = class_names[cls_id][:4] if cls_id < len(class_names) else f"c{cls_id}"\n        print(f" {short_name:>6}", end="")\n    print()\n\n    confusion = np.zeros((config.NUM_CLASSES, config.NUM_CLASSES), dtype=int)\n    for true_label, pred_label in zip(all_labels, all_preds):\n        confusion[true_label][pred_label] += 1\n\n    for i in range(config.NUM_CLASSES):\n        cls_name = class_names[i][:10] if i < len(class_names) else f"class_{i}"\n        print(f"  {cls_name:<10}", end="")\n        for j in range(config.NUM_CLASSES):\n            print(f" {confusion[i][j]:>6}", end="")\n        print()\n\n    # ---- 保存预测结果 ----\n    pred_output_path = os.path.join(config.OUTPUT_DIR, "test_predictions.txt")\n    with open(pred_output_path, "w", encoding="utf-8") as f:\n        f.write("标题\\t真实类别\\t预测类别\\t预测类别名\\t置信度\\n")\n        for i in range(len(test_texts)):\n            true_cls = all_labels[i]\n            pred_cls = all_preds[i]\n            confidence = all_probs[i][pred_cls]\n            true_name = class_names[true_cls] if true_cls < len(class_names) else f"class_{true_cls}"\n            pred_name = class_names[pred_cls] if pred_cls < len(class_names) else f"class_{pred_cls}"\n            f.write(f"{test_texts[i]}\\t{true_name}\\t{pred_cls}\\t{pred_name}\\t{confidence:.4f}\\n")\n    print(f"\\n预测结果已保存: {pred_output_path}")\n\n    return accuracy\n\n\n# ============================================================\n# 单条预测函数（方便复用）\n# ============================================================\ndef predict_single(text, model, vocab, max_seq_len, class_names, device):\n    """对单条文本进行预测，返回 (类别ID, 类别名, 置信度)"""\n    model.eval()\n    indices = vocab.encode(text, max_seq_len)\n    x = torch.tensor([indices], dtype=torch.long).to(device)\n\n    with torch.no_grad():\n        logits = model(x)\n        probs = torch.softmax(logits, dim=1)\n        pred_id = logits.argmax(dim=1).item()\n        confidence = probs[0][pred_id].item()\n\n    cls_name = class_names[pred_id] if pred_id < len(class_names) else f"class_{pred_id}"\n    return pred_id, cls_name, confidence\n\n\n# ============================================================\n# 主入口\n# ============================================================\ndef main():\n    parser = argparse.ArgumentParser(description="CNN 中文新闻标题分类器")\n    parser.add_argument("--mode", type=str, default="train",\n                        choices=["train", "test"],\n                        help="运行模式: train(训练) 或 test(测试)")\n    args = parser.parse_args()\n\n    config = Config()\n\n    if args.mode == "train":\n        train_model(config)\n    elif args.mode == "test":\n        # 检查模型文件是否存在\n        if not os.path.exists(config.MODEL_SAVE_PATH):\n            print(f"错误: 模型文件不存在: {config.MODEL_SAVE_PATH}")\n            print("请先运行训练: python cnn_classifier.py --mode train")\n            return\n        test_model(config)\n\n\nif __name__ == "__main__":\n    main()\n'}}], 'finish_reason': 'tool_calls'}
