20260621 09:49:31 - MainProcess | MainThread | runtime._execute_step:513 - DEBUG -{'content': 'Let me write the complete CNN classifier code:\n\n', 'tool_calls': [{'id': 'call_43b537f437844ba2b9da56f2', 'name': 'write_file', 'arguments': {'path': 'D:\\Project\\agent\\CodeGenX\\.data\\10\\code\\cnn_classifier.py', 'content': '"""\n新闻标题分类 - CNN (PyTorch)\n=============================\n功能：\n  1. 读取 data/ 下的 train.txt / dev.txt / test.txt（格式：标题\\t类别编号）\n  2. 字符级分词 + 构建词表\n  3. 训练 TextCNN 模型，每个 epoch 在 dev 集上验证\n  4. 训练结束后在 test 集上评估，保存最优模型\n  5. 支持 --predict 模式：加载已训练模型直接推理\n\n用法：\n  训练：  python cnn_classifier.py --mode train\n  测试：  python cnn_classifier.py --mode test\n  预测：  python cnn_classifier.py --mode predict --input your_file.txt\n"""\n\nimport os\nimport re\nimport json\nimport time\nimport argparse\nfrom collections import Counter\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\n\n# ============================================================\n# 配置\n# ============================================================\nBASE_DIR = os.path.dirname(os.path.abspath(__file__))\nDATA_DIR = os.path.join(BASE_DIR, "data")\nOUTPUT_DIR = os.path.join(BASE_DIR, "output")\nMODEL_DIR = os.path.join(OUTPUT_DIR, "saved_model")\n\nCLASS_NAMES = [\n    "finance",       # 0\n    "realty",        # 1\n    "stocks",        # 2\n    "education",     # 3\n    "science",       # 4\n    "society",       # 5\n    "politics",      # 6\n    "sports",        # 7\n    "game",          # 8\n    "entertainment", # 9\n]\nNUM_CLASSES = len(CLASS_NAMES)\n\n# 模型超参数\nMAX_SEQ_LEN = 64        # 标题最大字符数（截断/填充）\nEMBED_DIM = 256         # 词嵌入维度\nNUM_FILTERS = 256       # 每种卷积核数量\nKERNEL_SIZES = [2, 3, 4, 5]  # 多种卷积核尺寸\nDROPOUT = 0.3\nPAD_IDX = 0\nUNK_IDX = 1\n\n# 训练超参数\nBATCH_SIZE = 256\nEPOCHS = 20\nLR = 1e-3\nWEIGHT_DECAY = 1e-4\nPATIENCE = 5            # 早停耐心值\nDEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")\n\n\n# ============================================================\n# 数据加载与预处理\n# ============================================================\ndef load_data(filepath):\n    """\n    加载数据文件，返回 (texts, labels)\n    格式：每行 "标题\\t类别编号"\n    """\n    texts, labels = [], []\n    with open(filepath, "r", encoding="utf-8") as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.rsplit("\\t", 1)\n            if len(parts) != 2:\n                continue\n            text, label = parts[0].strip(), int(parts[1].strip())\n            texts.append(text)\n            labels.append(label)\n    return texts, labels\n\n\ndef tokenize_char(text):\n    """字符级分词：去除特殊字符，逐字切分"""\n    text = re.sub(r"\\s+", "", text)  # 去空白\n    return list(text)\n\n\ndef build_vocab(texts, min_freq=2, max_size=50000):\n    """\n    根据文本列表构建字符级词表\n    返回 char2idx 字典\n    """\n    counter = Counter()\n    for text in texts:\n        chars = tokenize_char(text)\n        counter.update(chars)\n\n    # 按频率排序，保留高频字符\n    vocab = ["<PAD>", "<UNK>"]  # 0: PAD, 1: UNK\n    for char, freq in counter.most_common(max_size):\n        if freq >= min_freq:\n            vocab.append(char)\n\n    char2idx = {ch: idx for idx, ch in enumerate(vocab)}\n    return char2idx\n\n\ndef encode_text(text, char2idx, max_len=MAX_SEQ_LEN):\n    """将文本编码为索引序列（截断/填充到 max_len）"""\n    chars = tokenize_char(text)\n    indices = [char2idx.get(ch, UNK_IDX) for ch in chars]\n    # 截断\n    if len(indices) > max_len:\n        indices = indices[:max_len]\n    # 填充\n    else:\n        indices = indices + [PAD_IDX] * (max_len - len(indices))\n    return indices\n\n\nclass NewsDataset(Dataset):\n    """新闻分类数据集"""\n\n    def __init__(self, texts, labels, char2idx, max_len=MAX_SEQ_LEN):\n        self.texts = texts\n        self.labels = labels\n        self.char2idx = char2idx\n        self.max_len = max_len\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        encoded = encode_text(self.texts[idx], self.char2idx, self.max_len)\n        return (\n            torch.tensor(encoded, dtype=torch.long),\n            torch.tensor(self.labels[idx], dtype=torch.long),\n        )\n\n\n# ============================================================\n# TextCNN 模型\n# ============================================================\nclass TextCNN(nn.Module):\n    """\n    TextCNN 文本分类模型\n    结构：Embedding → 多尺度 Conv1d → MaxPool → Concat → FC → Softmax\n    """\n\n    def __init__(\n        self,\n        vocab_size,\n        embed_dim=EMBED_DIM,\n        num_classes=NUM_CLASSES,\n        num_filters=NUM_FILTERS,\n        kernel_sizes=KERNEL_SIZES,\n        dropout=DROPOUT,\n        pad_idx=PAD_IDX,\n    ):\n        super().__init__()\n\n        self.embedding = nn.Embedding(\n            num_embeddings=vocab_size,\n            embedding_dim=embed_dim,\n            padding_idx=pad_idx,\n        )\n\n        # 多尺度卷积层\n        self.convs = nn.ModuleList(\n            [\n                nn.Conv1d(\n                    in_channels=embed_dim,\n                    out_channels=num_filters,\n                    kernel_size=ks,\n                    padding=0,\n                )\n                for ks in kernel_sizes\n            ]\n        )\n\n        self.dropout = nn.Dropout(dropout)\n        self.fc = nn.Linear(num_filters * len(kernel_sizes), num_classes)\n\n    def forward(self, x):\n        """\n        x: (batch_size, seq_len)  LongTensor\n        """\n        # Embedding: (batch, seq_len) -> (batch, seq_len, embed_dim)\n        embedded = self.embedding(x)\n\n        # Conv1d 需要 (batch, channels, length) 格式\n        # (batch, seq_len, embed_dim) -> (batch, embed_dim, seq_len)\n        embedded = embedded.permute(0, 2, 1)\n\n        # 多尺度卷积 + 池化\n        conv_outputs = []\n        for conv in self.convs:\n            # (batch, embed_dim, seq_len) -> (batch, num_filters, seq_len - ks + 1)\n            c = conv(embedded)\n            c = F.relu(c)\n            # 全局最大池化: (batch, num_filters, L) -> (batch, num_filters)\n            c = F.max_pool1d(c, kernel_size=c.size(2)).squeeze(2)\n            conv_outputs.append(c)\n\n        # 拼接所有卷积输出: (batch, num_filters * len(kernel_sizes))\n        concatenated = torch.cat(conv_outputs, dim=1)\n        concatenated = self.dropout(concatenated)\n\n        # 全连接分类\n        logits = self.fc(concatenated)  # (batch, num_classes)\n        return logits\n\n\n# ============================================================\n# 训练\n# ============================================================\ndef train_one_epoch(model, dataloader, criterion, optimizer, device):\n    model.train()\n    total_loss = 0.0\n    correct = 0\n    total = 0\n\n    for batch_x, batch_y in dataloader:\n        batch_x = batch_x.to(device)\n        batch_y = batch_y.to(device)\n\n        optimizer.zero_grad()\n        logits = model(batch_x)\n        loss = criterion(logits, batch_y)\n        loss.backward()\n        nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n        optimizer.step()\n\n        total_loss += loss.item() * batch_x.size(0)\n        preds = logits.argmax(dim=1)\n        correct += (preds == batch_y).sum().item()\n        total += batch_x.size(0)\n\n    avg_loss = total_loss / total\n    accuracy = correct / total\n    return avg_loss, accuracy\n\n\ndef evaluate(model, dataloader, criterion, device):\n    model.eval()\n    total_loss = 0.0\n    correct = 0\n    total = 0\n    all_preds = []\n    all_labels = []\n\n    with torch.no_grad():\n        for batch_x, batch_y in dataloader:\n            batch_x = batch_x.to(device)\n            batch_y = batch_y.to(device)\n\n            logits = model(batch_x)\n            loss = criterion(logits, batch_y)\n\n            total_loss += loss.item() * batch_x.size(0)\n            preds = logits.argmax(dim=1)\n            correct += (preds == batch_y).sum().item()\n            total += batch_x.size(0)\n\n            all_preds.extend(preds.cpu().tolist())\n            all_labels.extend(batch_y.cpu().tolist())\n\n    avg_loss = total_loss / total\n    accuracy = correct / total\n    return avg_loss, accuracy, all_preds, all_labels\n\n\ndef print_classification_report(labels, preds):\n    """打印每个类别的 precision / recall / f1"""\n    from collections import defaultdict\n\n    # 统计 TP, FP, FN\n    tp = defaultdict(int)\n    fp = defaultdict(int)\n    fn = defaultdict(int)\n    support = defaultdict(int)\n\n    for true_label, pred_label in zip(labels, preds):\n        support[true_label] += 1\n        if pred_label == true_label:\n            tp[true_label] += 1\n        else:\n            fp[pred_label] += 1\n            fn[true_label] += 1\n\n    print(f"\\n{\'类别\':<16} {\'Precision\':>10} {\'Recall\':>10} {\'F1\':>10} {\'Support\':>10}")\n    print("-" * 60)\n\n    total_tp = 0\n    total_support = 0\n\n    for cls_id in range(NUM_CLASSES):\n        name = CLASS_NAMES[cls_id]\n        p = tp[cls_id] / (tp[cls_id] + fp[cls_id]) if (tp[cls_id] + fp[cls_id]) > 0 else 0.0\n        r = tp[cls_id] / (tp[cls_id] + fn[cls_id]) if (tp[cls_id] + fn[cls_id]) > 0 else 0.0\n        f1 = 2 * p * r / (p + r) if (p + r) > 0 else 0.0\n        s = support[cls_id]\n        total_tp += tp[cls_id]\n        total_support += s\n        print(f"{name:<16} {p:>10.4f} {r:>10.4f} {f1:>10.4f} {s:>10}")\n\n    # 宏平均\n    print("-" * 60)\n    overall_acc = total_tp / total_support if total_support > 0 else 0.0\n    print(f"{\'总体准确率\':<16} {overall_acc:>10.4f}")\n\n\ndef save_model(model, char2idx, save_dir):\n    """保存模型和词表，方便后续加载推理"""\n    os.makedirs(save_dir, exist_ok=True)\n\n    # 保存模型权重\n    model_path = os.path.join(save_dir, "cnn_model.pt")\n    torch.save(model.state_dict(), model_path)\n\n    # 保存词表\n    vocab_path = os.path.join(save_dir, "char2idx.json")\n    with open(vocab_path, "w", encoding="utf-8") as f:\n        json.dump(char2idx, f, ensure_ascii=False, indent=2)\n\n    # 保存配置\n    config = {\n        "num_classes": NUM_CLASSES,\n        "class_names": CLASS_NAMES,\n        "max_seq_len": MAX_SEQ_LEN,\n        "embed_dim": EMBED_DIM,\n        "num_filters": NUM_FILTERS,\n        "kernel_sizes": KERNEL_SIZES,\n        "dropout": DROPOUT,\n        "pad_idx": PAD_IDX,\n    }\n    config_path = os.path.join(save_dir, "config.json")\n    with open(config_path, "w", encoding="utf-8") as f:\n        json.dump(config, f, ensure_ascii=False, indent=2)\n\n    print(f"\\n模型已保存到: {save_dir}")\n    print(f"  - cnn_model.pt   (模型权重)")\n    print(f"  - char2idx.json  (词表)")\n    print(f"  - config.json    (模型配置)")\n\n\ndef load_model(model_dir, device):\n    """加载已保存的模型"""\n    # 加载配置\n    config_path = os.path.join(model_dir, "config.json")\n    with open(config_path, "r", encoding="utf-8") as f:\n        config = json.load(f)\n\n    # 加载词表\n    vocab_path = os.path.join(model_dir, "char2idx.json")\n    with open(vocab_path, "r", encoding="utf-8") as f:\n        char2idx = json.load(f)\n\n    # 构建模型并加载权重\n    model = TextCNN(\n        vocab_size=len(char2idx),\n        embed_dim=config["embed_dim"],\n        num_classes=config["num_classes"],\n        num_filters=config["num_filters"],\n        kernel_sizes=config["kernel_sizes"],\n        dropout=config["dropout"],\n        pad_idx=config["pad_idx"],\n    )\n    model_path = os.path.join(model_dir, "cnn_model.pt")\n    model.load_state_dict(torch.load(model_path, map_location=device))\n    model.to(device)\n    model.eval()\n\n    return model, char2idx, config\n\n\n# ============================================================\n# 主流程\n# ============================================================\ndef run_train():\n    """训练流程"""\n    print("=" * 60)\n    print("新闻标题分类 - CNN 训练")\n    print("=" * 60)\n    print(f"设备: {DEVICE}")\n    print(f"数据目录: {DATA_DIR}")\n    print(f"输出目录: {OUTPUT_DIR}")\n\n    # 1. 加载数据\n    print("\\n[1/5] 加载数据...")\n    train_texts, train_labels = load_data(os.path.join(DATA_DIR, "train.txt"))\n    dev_texts, dev_labels = load_data(os.path.join(DATA_DIR, "dev.txt"))\n    print(f"  训练集: {len(train_texts)} 条")\n    print(f"  验证集: {len(dev_texts)} 条")\n\n    # 2. 构建词表\n    print("\\n[2/5] 构建词表...")\n    char2idx = build_vocab(train_texts, min_freq=2, max_size=50000)\n    print(f"  词表大小: {len(char2idx)}")\n\n    # 3. 创建数据集和 DataLoader\n    print("\\n[3/5] 创建 DataLoader...")\n    train_dataset = NewsDataset(train_texts, train_labels, char2idx)\n    dev_dataset = NewsDataset(dev_texts, dev_labels, char2idx)\n\n    train_loader = DataLoader(\n        train_dataset, batch_size=BATCH_SIZE, shuffle=True, num_workers=0\n    )\n    dev_loader = DataLoader(\n        dev_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=0\n    )\n\n    # 4. 构建模型\n    print("\\n[4/5] 构建模型...")\n    model = TextCNN(vocab_size=len(char2idx)).to(DEVICE)\n    total_params = sum(p.numel() for p in model.parameters())\n    trainable_params = sum(p.numel() for p in model.parameters() if p.requires_grad)\n    print(f"  总参数量: {total_params:,}")\n    print(f"  可训练参数: {trainable_params:,}")\n    print(model)\n\n    criterion = nn.CrossEntropyLoss()\n    optimizer = torch.optim.Adam(model.parameters(), lr=LR, weight_decay=WEIGHT_DECAY)\n    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n        optimizer, mode="min", factor=0.5, patience=2, verbose=True\n    )\n\n    # 5. 训练循环\n    print("\\n[5/5] 开始训练...")\n    print("-" * 60)\n    best_dev_acc = 0.0\n    patience_counter = 0\n    best_model_state = None\n\n    for epoch in range(1, EPOCHS + 1):\n        start_time = time.time()\n\n        train_loss, train_acc = train_one_epoch(\n            model, train_loader, criterion, optimizer, DEVICE\n        )\n        dev_loss, dev_acc, _, _ = evaluate(model, dev_loader, criterion, DEVICE)\n        scheduler.step(dev_loss)\n\n        elapsed = time.time() - start_time\n        print(\n            f"Epoch {epoch:>2}/{EPOCHS} | "\n            f"Train Loss: {train_loss:.4f} Acc: {train_acc:.4f} | "\n            f"Dev Loss: {dev_loss:.4f} Acc: {dev_acc:.4f} | "\n            f"Time: {elapsed:.1f}s"\n        )\n\n        # 保存最优模型\n        if dev_acc > best_dev_acc:\n            best_dev_acc = dev_acc\n            patience_counter = 0\n            best_model_state = {k: v.clone() for k, v in model.state_dict().items()}\n            print(f"  ★ 新最优模型! Dev Acc: {best_dev_acc:.4f}")\n        else:\n            patience_counter += 1\n            if patience_counter >= PATIENCE:\n                print(f"\\n早停: 连续 {PATIENCE} 个 epoch 无提升")\n                break\n\n    # 6. 恢复最优模型并保存\n    if best_model_state is not None:\n        model.load_state_dict(best_model_state)\n    print(f"\\n最佳验证准确率: {best_dev_acc:.4f}")\n\n    save_model(model, char2idx, MODEL_DIR)\n\n    # 7. 在测试集上评估\n    test_file = os.path.join(DATA_DIR, "test.txt")\n    if os.path.exists(test_file):\n        print("\\n" + "=" * 60)\n        print("在测试集上评估最优模型...")\n        test_texts, test_labels = load_data(test_file)\n        test_dataset = NewsDataset(test_texts, test_labels, char2idx)\n        test_loader = DataLoader(\n            test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=0\n        )\n        test_loss, test_acc, test_preds, test_true = evaluate(\n            model, test_loader, criterion, DEVICE\n        )\n        print(f"测试集 Loss: {test_loss:.4f}  Acc: {test_acc:.4f}")\n        print_classification_report(test_true, test_preds)\n\n    print("\\n训练完成!")\n\n\ndef run_test():\n    """测试流程：加载已保存模型，在测试集上评估"""\n    print("=" * 60)\n    print("新闻标题分类 - CNN 测试")\n    print("=" * 60)\n\n    if not os.path.exists(MODEL_DIR):\n        print(f"错误: 模型目录不存在: {MODEL_DIR}")\n        print("请先运行训练: python cnn_classifier.py --mode train")\n        return\n\n    # 加载模型\n    print("加载模型...")\n    model, char2idx, config = load_model(MODEL_DIR, DEVICE)\n    max_seq_len = config["max_seq_len"]\n    print(f"  词表大小: {len(char2idx)}")\n    print(f"  最大序列长度: {max_seq_len}")\n\n    # 加载测试数据\n    test_file = os.path.join(DATA_DIR, "test.txt")\n    if not os.path.exists(test_file):\n        print(f"错误: 测试文件不存在: {test_file}")\n        return\n\n    test_texts, test_labels = load_data(test_file)\n    print(f"  测试集: {len(test_texts)} 条")\n\n    test_dataset = NewsDataset(test_texts, test_labels, char2idx, max_seq_len)\n    test_loader = DataLoader(\n        test_dataset, batch_size=BATCH_SIZE, shuffle=False, num_workers=0\n    )\n\n    # 评估\n    criterion = nn.CrossEntropyLoss()\n    test_loss, test_acc, test_preds, test_true = evaluate(\n        model, test_loader, criterion, DEVICE\n    )\n\n    print(f"\\n测试集 Loss: {test_loss:.4f}  Acc: {test_acc:.4f}")\n    print_classification_report(test_true, test_preds)\n\n\ndef run_predict(input_file):\n    """预测流程：加载模型，对输入文件进行预测"""\n    print("=" * 60)\n    print("新闻标题分类 - CNN 预测")\n    print("=" * 60)\n\n    if not os.path.exists(MODEL_DIR):\n        print(f"错误: 模型目录不存在: {MODEL_DIR}")\n        return\n\n    # 加载模型\n    model, char2idx, config = load_model(MODEL_DIR, DEVICE)\n    max_seq_len = config["max_seq_len"]\n\n    # 加载待预测数据（可能没有标签）\n    texts = []\n    true_labels = []\n    with open(input_file, "r", encoding="utf-8") as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            parts = line.rsplit("\\t", 1)\n            texts.append(parts[0].strip())\n            if len(parts) == 2:\n                try:\n                    true_labels.append(int(parts[1].strip()))\n                except ValueError:\n                    true_labels.append(-1)\n            else:\n                true_labels.append(-1)\n\n    print(f"  待预测: {len(texts)} 条")\n\n    # 逐条预测\n    model.eval()\n    results = []\n    with torch.no_grad():\n        for i in range(0, len(texts), BATCH_SIZE):\n            batch_texts = texts[i : i + BATCH_SIZE]\n            batch_encoded = [\n                encode_text(t, char2idx, max_seq_len) for t in batch_texts\n            ]\n            batch_tensor = torch.tensor(batch_encoded, dtype=torch.long).to(DEVICE)\n            logits = model(batch_tensor)\n            probs = F.softmax(logits, dim=1)\n            preds = probs.argmax(dim=1).cpu().tolist()\n            max_probs = probs.max(dim=1).values.cpu().tolist()\n\n            for j, (text, pred, prob) in enumerate(\n                zip(batch_texts, preds, max_probs)\n            ):\n                results.append(\n                    {\n                        "text": text,\n                        "pred_label": pred,\n                        "pred_class": CLASS_NAMES[pred],\n                        "confidence": round(prob, 4),\n                        "true_label": true_labels[i + j],\n                    }\n                )\n\n    # 输出结果\n    correct = sum(\n        1 for r in results if r["true_label"] >= 0 and r["pred_label"] == r["true_label"]\n    )\n    labeled = sum(1 for r in results if r["true_label"] >= 0)\n\n    print(f"\\n预测结果（前 20 条）:")\n    print("-" * 80)\n    for r in results[:20]:\n        true_str = (\n            f"真实: {CLASS_NAMES[r[\'true_label\']]}"\n            if r["true_label"] >= 0\n            else "真实: N/A"\n        )\n        print(\n            f"  [{r[\'pred_class\']:<14}] 置信度: {r[\'confidence\']:.4f}  {true_str}  | {r[\'text\'][:40]}"\n        )\n\n    if labeled > 0:\n        print(f"\\n有标签样本准确率: {correct}/{labeled} = {correct / labeled:.4f}")\n\n    # 保存预测结果\n    output_path = os.path.join(OUTPUT_DIR, "predictions.json")\n    with open(output_path, "w", encoding="utf-8") as f:\n        json.dump(results, f, ensure_ascii=False, indent=2)\n    print(f"\\n预测结果已保存到: {output_path}")\n\n\n# ============================================================\n# 入口\n# ============================================================\ndef main():\n    parser = argparse.ArgumentParser(description="新闻标题分类 - TextCNN")\n    parser.add_argument(\n        "--mode",\n        type=str,\n        choices=["train", "test", "predict"],\n        default="train",\n        help="运行模式: train(训练), test(测试), predict(预测)",\n    )\n    parser.add_argument(\n        "--input",\n        type=str,\n        default=None,\n        help="预测模式下的输入文件路径",\n    )\n    parser.add_argument("--epochs", type=int, default=EPOCHS, help="训练轮数")\n    parser.add_argument("--batch_size", type=int, default=BATCH_SIZE, help="批大小")\n    parser.add_argument("--lr", type=float, default=LR, help="学习率")\n\n    args = parser.parse_args()\n\n    # 更新全局配置\n    global EPOCHS, BATCH_SIZE, LR\n    EPOCHS = args.epochs\n    BATCH_SIZE = args.batch_size\n    LR = args.lr\n\n    os.makedirs(OUTPUT_DIR, exist_ok=True)\n\n    if args.mode == "train":\n        run_train()\n    elif args.mode == "test":\n        run_test()\n    elif args.mode == "predict":\n        if args.input is None:\n            print("错误: 预测模式需要指定 --input 参数")\n            return\n        run_predict(args.input)\n\n\nif __name__ == "__main__":\n    main()\n'}}], 'finish_reason': 'tool_calls'}
